@page "{id:guid}"
@model Tanda.Web.Pages.Customers.DetailsModel
@using Tanda.Domain.ReadModels
@{ ViewData["Title"] = "Detalle del cliente"; }
<h1>Detalle del cliente</h1>

@if (Model.Customer is not null)
{
    <div class="card mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Documento</dt>
                <dd class="col-sm-9">@Model.Customer.DocumentType @Model.Customer.DocumentNumber</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Customer.FullName</dd>

                <dt class="col-sm-3">Teléfono</dt>
                <dd class="col-sm-9">@Model.Customer.Phone</dd>

                <dt class="col-sm-3">Correo</dt>
                <dd class="col-sm-9">@Model.Customer.Email</dd>

                <dt class="col-sm-3">Consentimiento</dt>
                <dd class="col-sm-9">
                    @if (Model.Customer.DataConsentDate.HasValue)
                    {
                        <span>Autorizó el @Model.Customer.DataConsentDate.Value.ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">Este cliente no ha autorizado el tratamiento de sus datos.</div>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <h2 class="h4">Historial de pedidos</h2>

    if (!Model.Orders.Any())
    {
        <div class="alert alert-info">Este cliente no tiene pedidos registrados.</div>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Fecha de solicitud</th>
                    <th>Fecha de entrega</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Abonado</th>
                    <th>Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.Number</td>
                        <td>@order.RequestDate.ToString("dd/MM/yyyy")</td>
                        <td>@order.DeliveryDate.ToString("dd/MM/yyyy")</td>
                        <td>@order.Status</td>
                        <td>@order.TotalAmount.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                        <td>@order.PaidAmount.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                        <td>@order.Balance.ToString("C0", new System.Globalization.CultureInfo("es-CO"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<div class="mt-3">
    <a asp-page="Index" class="btn btn-secondary">Volver al listado</a>
</div>
