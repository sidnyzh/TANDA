@page "{id:guid}"
@model Tanda.Web.Pages.Catalog.Products.EditModel
@{ ViewData["Title"] = "Editar producto"; }
<h1>Editar producto</h1>
<form method="post">
    <input asp-for="Input.Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Input.Name"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.Category"></label><select asp-for="Input.Category" asp-items="Model.Categories" class="form-select"><option value="">Seleccione una categor?a</option></select><span asp-validation-for="Input.Category" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.MinimumLeadDays"></label><input asp-for="Input.MinimumLeadDays" class="form-control" /><span asp-validation-for="Input.MinimumLeadDays" class="text-danger"></span></div>

    <fieldset class="mb-3">
        <legend>Tamaños</legend>
        <table class="table">
            <thead>
                <tr><th>Seleccionar</th><th>Precio base</th><th>Esfuerzo</th></tr>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.Input.Sizes.Count; i++)
            {
                var registered = Model.RegisteredSizeNames.Contains(Model.Input.Sizes[i].Name);
                <tr>
                    <td>
                        <input asp-for="Input.Sizes[i].Name" type="hidden" />
                        <div class="form-check">
                            <input asp-for="Input.Sizes[i].Selected" class="form-check-input size-selection" checked="@(registered ? "checked" : null)" disabled="@(registered ? "disabled" : null)" />
                            <label asp-for="Input.Sizes[i].Selected" class="form-check-label">@Model.Input.Sizes[i].Name</label>
                            @if (registered)
                            {
                                <span class="text-muted">(ya registrado)</span>
                            }
                        </div>
                    </td>
                    <td>
                        <input asp-for="Input.Sizes[i].BasePrice" class="form-control size-value" type="number" min="0.01" step="0.01" disabled="@(registered ? "disabled" : null)" />
                        <span asp-validation-for="Input.Sizes[i].BasePrice" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Input.Sizes[i].Esfuerzo" class="form-control size-value" type="number" min="1" max="10" disabled="@(registered ? "disabled" : null)" />
                        <span asp-validation-for="Input.Sizes[i].Esfuerzo" class="text-danger"></span>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </fieldset>

    <button class="btn btn-primary">Guardar</button> <a asp-page="Index">Cancelar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
<script>
    document.querySelectorAll(".size-selection:not(:disabled)").forEach(function (checkbox) {
        var row = checkbox.closest("tr");
        var fields = row.querySelectorAll(".size-value");

        function updateFields() {
            fields.forEach(function (field) {
                field.disabled = !checkbox.checked;
            });
        }

        checkbox.addEventListener("change", updateFields);
        updateFields();
    });
</script>
