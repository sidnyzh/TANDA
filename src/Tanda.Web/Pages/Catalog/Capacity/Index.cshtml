@page
@model Tanda.Web.Pages.Catalog.Capacity.IndexModel
@{ViewData["Title"]="Capacidad diaria";}<h1>Capacidad diaria</h1>@if(TempData["Message"] is string message){<div class="alert alert-success">@message</div>}<form method="post" class="row g-2 mb-4"><div class="col-auto"><label asp-for="Input.Date"></label><input asp-for="Input.Date" type="date" class="form-control"/></div><div class="col-auto"><label asp-for="Input.TotalEsfuerzo"></label><input asp-for="Input.TotalEsfuerzo" class="form-control"/></div><div class="col-auto align-self-end"><button class="btn btn-primary">Guardar</button></div><div asp-validation-summary="ModelOnly" class="text-danger"></div><span asp-validation-for="Input.TotalEsfuerzo" class="text-danger"></span></form><table class="table"><thead><tr><th>Fecha</th><th>Total esfuerzo</th><th>Esfuerzo comprometido</th></tr></thead><tbody>@foreach(var day in Model.Days){<tr><td>@day.Date</td><td>@day.Total</td><td>@day.Committed</td></tr>}</tbody></table>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
